# Copy to .env for docker compose. Values marked "required" must be set.

# First administrator (created on first start only).
WITDEN_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
WITDEN_BOOTSTRAP_ADMIN_PASSWORD=change-me-please

# required: master key that encrypts model API keys and chat credentials, shared by api and worker.
# Generate with: docker compose run --rm api node packages/server/dist/cli.js gen-key
# Losing it makes stored secrets unreadable.
WITDEN_SECRET_KEY=

# required: shared secrets between the processes (any long random strings, e.g. `openssl rand -hex 24`).
WITDEN_MANAGER_TOKEN=
WITDEN_INTERNAL_TOKEN=
POSTGRES_PASSWORD=

# required: group id of the Docker socket, so only the manager can use it: stat -c %g /var/run/docker.sock
DOCKER_GID=

# Public address of the platform (links and webhook URLs shown in the console).
WITDEN_PUBLIC_URL=http://localhost:8320

# Runner hub address as seen from inside the computers (they resolve witden-hub to the host gateway).
# WITDEN_HUB_URL_FOR_COMPUTERS=ws://witden-hub:8330/runner
# Interface the hub port is published on; the Docker bridge address keeps it off other networks.
# WITDEN_HUB_BIND=172.17.0.1

# Agent loops run in parallel per worker process.
WITDEN_WORKER_CONCURRENCY=4

# Optional: the open-source Laya decision model (a System 1 model) for the topic dispatcher, run on CPU by
# the "laya" service. Uncomment the three lines below; the first start downloads about 700 MB of weights.
# The platform then adds it under Models and, if no dispatcher model is set yet, uses it as the dispatcher.
# WITDEN_LAYA_API_KEY: any long random string, e.g. `openssl rand -hex 24` (shared by Laya and the platform).
# COMPOSE_PROFILES=laya
# WITDEN_LAYA_URL=http://laya:8000
# WITDEN_LAYA_API_KEY=
